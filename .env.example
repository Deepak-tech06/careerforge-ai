# CareerForgeAI — Docker Compose Environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_random_password
POSTGRES_DB=careerforge

DATABASE_URL=postgresql://postgres:replace_with_password@db:5432/careerforge
DIRECT_URL=postgresql://postgres:replace_with_password@db:5432/careerforge

JWT_SECRET=replace_with_a_strong_random_secret_minimum_64_characters

PORT=3001
AI_SERVICE_URL=http://ai-service:8000
FRONTEND_URL=http://localhost:3000

# Optional: URL for the frontend (used in Docker context)
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
