# CareerForgeAI — Docker Compose Environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_random_password
POSTGRES_DB=careerforge

# PostgreSQL Database Connections:
# - DATABASE_URL: Pooled connection string used by the backend at runtime.
# - DIRECT_URL: Direct/unpooled connection string used by Prisma CLI for migrations.
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@endpoint.region.aws.neon.tech/dbname?sslmode=require

JWT_SECRET=replace_with_a_strong_random_secret_minimum_64_characters

PORT=3001
AI_SERVICE_URL=http://ai-service:8000
FRONTEND_URL=http://localhost:3000

# Optional: URL for the frontend (used in Docker context)
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
