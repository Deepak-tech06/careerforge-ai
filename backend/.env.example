# CareerForgeAI — Backend Local Development Environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Generate a secure PostgreSQL password:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Generate a secure JWT secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

DATABASE_URL=postgresql://postgres:replace_with_password@localhost:5432/careerforge
DIRECT_URL=postgresql://postgres:replace_with_password@localhost:5432/careerforge

JWT_SECRET=replace_with_a_strong_random_secret_minimum_64_characters

PORT=3001
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Optional: Email address that receives ADMIN role on registration.
# If not set, all users receive USER role.
# ADMIN_EMAIL=your_admin_email_here
